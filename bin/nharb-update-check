#!/usr/bin/env bash
# nharb-update-check: compare the installed nharb release with the project's pin and the latest
# release on GitHub.
#
# Prints exactly one line:
#   NOT_PINNED <installed>                  the project's .claude/skills/pinned-versions has no nharb line
#   UP_TO_DATE <installed>
#   UPGRADE_AVAILABLE <installed> <latest>
#   CHECK_FAILED <reason>
#
# A release is a tag vX.Y.Z on the skills repository. The latest release is read with
# `git ls-remote`, so nothing is downloaded and nothing on disk changes.
set -uo pipefail

DIR="${NHARB_DIR:-$HOME/.claude/skills/nharb}"
PIN_FILE="${CLAUDE_PROJECT_DIR:-$PWD}/.claude/skills/pinned-versions"

installed="$(tr -d '[:space:]' 2>/dev/null < "$DIR/VERSION" || true)"
if [[ -z "$installed" ]]; then
  echo "CHECK_FAILED no VERSION file in $DIR"
  exit 0
fi

pinned_repo="$(awk '$1 == "nharb" { print $3; exit }' "$PIN_FILE" 2>/dev/null || true)"
if [[ -z "$pinned_repo" ]]; then
  echo "NOT_PINNED $installed"
  exit 0
fi
REMOTE="${NHARB_REMOTE:-$pinned_repo}"

if ! tags="$(git ls-remote --tags --refs "$REMOTE" 'v*' 2>/dev/null)"; then
  echo "CHECK_FAILED cannot reach $REMOTE"
  exit 0
fi

latest="$(printf '%s\n' "$tags" \
  | sed -n 's#.*refs/tags/v\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$#\1#p' \
  | sort -V | tail -1)"
if [[ -z "$latest" ]]; then
  echo "CHECK_FAILED no release tag vX.Y.Z on $REMOTE"
  exit 0
fi

# Newer than installed only when sort -V puts latest last and the two differ.
highest="$(printf '%s\n%s\n' "$installed" "$latest" | sort -V | tail -1)"
if [[ "$latest" != "$installed" && "$highest" == "$latest" ]]; then
  echo "UPGRADE_AVAILABLE $installed $latest"
else
  echo "UP_TO_DATE $installed"
fi
