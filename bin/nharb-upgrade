#!/usr/bin/env bash
# nharb-upgrade <X.Y.Z> [project-dir]: move the project's nharb pin to release X.Y.Z and install it.
#
# Rewrites the nharb line of <project-dir>/.claude/skills/pinned-versions, then runs the project's
# hook (.claude/hooks/pinned-skills.sh, or this release's hooks/session-start.sh when the project
# has none), which installs exactly the pinned release. Commits nothing: the caller commits the
# pin file under the project's own rules.
set -uo pipefail

V="${1:-}"
PROJECT="${2:-${CLAUDE_PROJECT_DIR:-$PWD}}"
PIN_FILE="$PROJECT/.claude/skills/pinned-versions"
SELF="$(cd "$(dirname "$0")/.." && pwd)"

if [[ ! "$V" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "nharb: '$V' is not a version X.Y.Z" >&2
  exit 2
fi
if ! awk '$1 == "nharb" { found = 1 } END { exit !found }' "$PIN_FILE" 2>/dev/null; then
  echo "nharb: $PIN_FILE has no nharb line; set the project up with /nharb:install first"
  exit 1
fi

old="$(awk '$1 == "nharb" { print $2; exit }' "$PIN_FILE")"
tmp="$PIN_FILE.tmp.$$"
awk -v v="$V" '$1 == "nharb" { $2 = v } { print }' "$PIN_FILE" > "$tmp" && mv "$tmp" "$PIN_FILE"

HOOK="$PROJECT/.claude/hooks/pinned-skills.sh"
[[ -x "$HOOK" ]] || HOOK="$SELF/hooks/session-start.sh"
CLAUDE_PROJECT_DIR="$PROJECT" bash "$HOOK" | grep '^nharb:' || true

installed="$(tr -d '[:space:]' 2>/dev/null < "$SELF/VERSION" || true)"
if [[ "$installed" == "$V" ]]; then
  echo "nharb: pin $PIN_FILE changed $old -> $V (commit it)"
else
  echo "nharb: pin changed $old -> $V, but the installed copy is ${installed:-missing}; see the line above"
  exit 1
fi
